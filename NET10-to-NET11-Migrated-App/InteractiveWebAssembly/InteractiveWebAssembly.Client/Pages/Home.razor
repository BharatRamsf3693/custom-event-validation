@page "/"
@using InteractiveServer.Components.CustomEvents

@inject IJSRuntime JS

<PageTitle>ScrollTop collision</PageTitle>

<h1>Notifications</h1>

<p>
    Scroll down the notifications, then use the button to return to the top.
</p>

<button class="btn btn-primary mb-3" @onclick="ScrollToTopAsync">Back to top</button>

<div id="event-target"
     class="activity-feed"
     @onscroll="OnScrollHandler"
     @oncustomscroll="OnCustomScrollHandler"
     @onscrolltop="OnScrollTopHandler"
     @oncustomscrolltop="OnCustomScrollTopHandler">
    @foreach (var item in activityItems)
    {
        <div class="activity-item">
            <strong>@item.Title</strong>
            <span>@item.Description</span>
        </div>
    }
</div>

<p class="mt-3">
    <br />
    <strong>Custom events registered for a native browser event(scroll):</strong><br />

    Custom event name matches the underlying <code>browserEventName</code>: <strong>@scroll</strong><br />
    Custom event name differs from the underlying <code>browserEventName</code>: <strong>@customScroll</strong>

    <br /><br />
    <strong>Custom events registered for another custom event(scrolltop):</strong><br />

    Custom event name matches the underlying <code>browserEventName</code>: <strong>@scrolltop</strong><br />
    Custom event name differs from the underlying <code>browserEventName</code>: <strong>@customScrolltop</strong>

    @if (!string.IsNullOrEmpty(message))
    {
        <em> - @message</em>
    }
</p>

<p>
    On .NET 10, one dispatch is expected to invoke the handler twice. On .NET
    11, Blazor.registerCustomEventType is expected to reject the colliding custom event registration.
</p>

@code {
    private const string TargetId = "event-target";
    private int scrolltop;
    private int customScrolltop;
    private int scroll;
    private int customScroll;
    private string? message;

    public class ActivityItem
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
    }

    private readonly List<ActivityItem> activityItems = new List<ActivityItem>();

    protected override void OnInitialized()
    {
        for (int index = 1; index <= 12; index++)
        {
            activityItems.Add(new ActivityItem
            {
                Title = "Notification " + index,
                Description = "A new update is available for item " + index + "."
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("initializeScrollTop", TargetId);
            }
            catch (Exception ex)
            {
                // Handles network disconnections or Blazor circuit crashes
                Console.WriteLine($"Interop failed: {ex.Message}");
            }
        }
    }

    private async Task ScrollToTopAsync()
    {
            try
            {
                await JS.InvokeVoidAsync("scrollToTop", TargetId);
            }
            catch (Exception ex)
            {
                // Handles network disconnections or Blazor circuit crashes
                Console.WriteLine($"Interop failed: {ex.Message}");
            }
    }

    private void OnScrollHandler()
    {
        scroll++;
    }

    private void OnCustomScrollHandler(CustomScrollEventArgs eventArgs)
    {
        customScroll++;
    }

    private void OnScrollTopHandler(ScrollTopEventArgs eventArgs)
    {
        scrolltop++;
    }

    private void OnCustomScrollTopHandler(ScrollTopEventArgs eventArgs)
    {
        customScrolltop++;
        message = eventArgs.Message;
    }
}
